# Copy this file to .env and fill it in.

# Admin dashboard login (HTTP Basic auth). Use a long, unique password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Port the server listens on.
PORT=3000

# Address encoded in the QR codes. Phones must be able to open it.
# Leave empty to use this computer's LAN IP (e.g. http://192.168.1.20:3000).
# When deployed, set your public HTTPS address, e.g. https://attendance.platcorpgroup.com
BASE_URL=

# Optional: only accept these email domains (comma-separated), e.g. platcorpgroup.com,platinumcredit.co.ke
ALLOWED_EMAIL_DOMAINS=

# Optional: where the SQLite database is stored (default: ./data/attendance.db)
# DB_PATH=./data/attendance.db

# Cybersecurity Awareness quishing simulation. true = the attendee page becomes an
# enticing party-invite lure and reveals the security-awareness test on submit.
# Edit the lure and reveal copy in config.js. Default off.
AWARENESS_MODE=false
